{
  "name": "angular-edu-app",
  "version": "1.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --configuration=en",
    "start:fr": "ng serve --configuration=fr",
    "build": "ng build",
    "build:en": "ng build --configuration=en",
    "build:fr": "ng build --configuration=fr",
    "watch": "ng build --watch --configuration development",
